PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rentalhub
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRES_IN=7d
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional, explicit local-only persistence fallback (requires mongodb-memory-server installed separately):
# USE_IN_MEMORY_DB=true
# Development OTP codes appear in the registration screen. OTP verification is disabled in production.
# Optional password-reset email adapter. It must accept POST /messages with
# { to, resetUrl }; PASSWORD_RESET_URL is the frontend reset-password route.
# PASSWORD_RESET_PROVIDER_URL=
# PASSWORD_RESET_PROVIDER_TOKEN=
# PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Image uploads use local storage by default; set UPLOAD_DIR to change its location.
# For Cloudinary, set UPLOAD_PROVIDER=cloudinary and provide the server-only credentials.
# UPLOAD_PROVIDER=local
# UPLOAD_DIR=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=rentalhub
